# Port cho signaling server (mặc định 3000)
PORT=3000

# Force HTTP mode (dùng khi có reverse proxy phía trước)
# Khi FORCE_HTTP=1, server luôn chạy HTTP thay vì tự động dùng certs
FORCE_HTTP=0

# URL của signaling server (tùy chọn — client tự động suy từ URL trang web nếu không set)
# Chỉ cần set nếu truy cập trang web qua địa chỉ khác với signaling server
# SIGNALING_URL=wss://your-domain.com:3000

# IP public của VPS (bắt buộc khi chạy coturn)
# Dùng cho external-ip và relay-ip trong turnserver.conf
# Lấy bằng lệnh: curl -s ifconfig.me
# VPS_PUBLIC_IP=165.101.114.100
